[2026.11.12-21.45.38:000][146]LogPython: exec("import unreal, subprocess\ndef CB(s): subprocess.run('clip',input=str(s).encode('utf-16'),shell=True)\nlog=[]\nsds=unreal.get_engine_subsystem(unreal.SubobjectDataSubsystem)\nL=unreal.SubobjectDataBlueprintFunctionLibrary\neas=unreal.get_editor_subsystem(unreal.EditorActorSubsystem)\n# 1) BP_EventoLimpiavidrios\npath='/Game/Evento/BP_EventoLimpiavidrios'\nif unreal.EditorAssetLibrary.does_asset_exist(path):\n    bp=unreal.load_asset(path)\nelse:\n    f=unreal.BlueprintFactory(); f.set_editor_property('parent_class',unreal.Actor)\n    bp=unreal.AssetToolsHelpers.get_asset_tools().create_asset('BP_EventoLimpiavidrios','/Game/Evento',unreal.Blueprint,f)\nhs=sds.k2_gather_subobject_data_for_blueprint(bp)\nnames=[str(L.get_variable_name(L.get_data(h))) for h in hs]\nlog.append(('lv names',names))\nif 'Limpiavidrios' not in names:\n    p=unreal.AddNewSubobjectParams(parent_handle=hs[1] if len(hs)>1 else hs[0],new_class=unreal.StaticMeshComponent,blueprint_context=bp)\n    h,fail=sds.add_new_subobject(p); log.append(('add lv',str(fail)))\n    sds.rename_subobject(h,unreal.Text('Limpiavidrios'))\n    o=L.get_object(L.get_data(h))\n    o.set_editor_property('static_mesh',unreal.load_asset('/Game/Assets/Limpia_vidrios/limpiavidrios'))\n    o.set_editor_property('mobility',unreal.ComponentMobility.MOVABLE)\nunreal.BlueprintEditorLibrary.compile_blueprint(bp)\ncdo=unreal.get_default_object(bp.generated_class())\nt=cdo.get_editor_property('primary_actor_tick'); t.set_editor_property('start_with_tick_enabled',False); cdo.set_editor_property('primary_actor_tick',t)\nlog.append(('tick',cdo.get_editor_property('primary_actor_tick').get_editor_property('start_with_tick_enabled')))\n# 2) Subtitulo en BP_EventoPC\npc=unreal.load_asset('/Game/Evento/BP_EventoPC')\nhs=sds.k2_gather_subobject_data_for_blueprint(pc)\nnames=[str(L.get_variable_name(L.get_data(h))) for h in hs]\nlog.append(('pc names',names))\nif 'Subtitulo' not in names:\n    p=unreal.AddNewSubobjectParams(parent_handle=hs[1],new_class=unreal.TextRenderComponent,blueprint_context=pc)\n    h,fail=sds.add_new_subobject(p); log.append(('add sub',str(fail)))\n    sds.rename_subobject(h,unreal.Text('Subtitulo'))\n    o=L.get_object(L.get_data(h))\n    o.set_editor_property('text',unreal.Text(''))\n    o.set_editor_property('world_size',1.0)\n    o.set_editor_property('horizontal_alignment',unreal.HorizTextAligment.EHTA_CENTER)\n    o.set_editor_property('vertical_alignment',unreal.VerticalTextAligment.EVRTA_TEXT_CENTER)\n    o.set_editor_property('text_render_color',unreal.Color(255,255,255,255))\n    o.set_editor_property('relative_location',unreal.Vector(0,0,-7))\n    o.set_editor_property('visible',False)\nunreal.BlueprintEditorLibrary.compile_blueprint(pc)\n# 3) reemplazar actor del nivel\nA={a.get_actor_label():a for a in eas.get_all_level_actors()}\nif 'EventoLimpiavidrios' not in A and 'limpiavidrios' in A:\n    l=A['limpiavidrios']\n    n=eas.spawn_actor_from_class(bp.generated_class(),l.get_actor_location(),l.get_actor_rotation())\n    n.set_actor_scale3d(l.get_actor_scale3d()); n.set_actor_label('EventoLimpiavidrios')\n    mat=l.static_mesh_component.get_materials()\n    lc=n.get_components_by_class(unreal.StaticMeshComponent)[0]\n    for i,m in enumerate(mat): lc.set_material(i,m)\n    eas.destroy_actor(l); log.append('replaced')\nfor a in (bp,pc): unreal.EditorAssetLibrary.save_loaded_asset(a)\nCB(log)\n")
